# Copy this file to .env and adjust as needed. All values shown are
# the defaults already baked into backend/config.py and the services,
# so .env itself is optional for local development.

# --- Database ---
DATABASE_URL=sqlite:///./backend/database/app.db

# --- Storage ---
UPLOAD_DIR=outputs/uploads
TTS_OUTPUT_DIR=outputs/tts
MAX_UPLOAD_MB=20

# --- Object detection ---
YOLO_MODEL_PATH=models/yolo/yolo11n.pt
YOLO_CONF_THRESHOLD=0.4

# --- Speech ---
WHISPER_MODEL_SIZE=base

# --- Sign language ---
SIGN_MODEL_DIR=models/sign_language
